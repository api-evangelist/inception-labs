{
  "opencollection": "1.0.0",
  "info": {
    "name": "Inception Chat Edit API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Edit",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a code edit completion",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.inceptionlabs.ai/v1/edit/completions",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generate an edit to a code region given the surrounding context. The request must contain a single user message whose content includes the required edit prompt tags (e.g. `<|code_to_edit|>`, `<|cursor|>`, `<|current_file_content|>`). Returns an `EditCompletion` object. Streaming and tool calling are not supported on this endpoint."
        }
      ]
    }
  ],
  "bundled": true
}