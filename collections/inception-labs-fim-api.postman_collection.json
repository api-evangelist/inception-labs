  "item": [
    {
      "id": "ef120fa8-8c26-4cee-8f41-89b07dc82fe9",
      "name": "FIM",
      "description": {
        "content": "Fill-in-the-middle code completion endpoints.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "eef5538f-d3ef-452b-9d2d-82ca3366e787",
          "name": "Create a fill-in-the-middle completion",
          "request": {
            "name": "Create a fill-in-the-middle completion",
            "description": {
              "content": "Generate a code completion given a `prompt` (prefix) and optional `suffix`. Designed for IDE-style inline completion. Returns a `FimCompletion` object, or a server-sent events stream of `FimCompletionChunk` deltas when `stream=true`. Tool calling and function calling are not supported.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "fim",
                "completions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"<string>\",\n  \"model\": \"<string>\",\n  \"suffix\": \"<string>\",\n  \"max_tokens\": 512,\n  \"top_p\": 1,\n  \"top_k\": -1,\n  \"frequency_penalty\": 0,\n  \"presence_penalty\": 1.5,\n  \"repetition_penalty\": 1,\n  \"stop\": [\n    \"\\n\\n\",\n    \"\\n \\n\"\n  ],\n  \"stream\": false,\n  \"stream_options\": {\n    \"include_usage\": false\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "019e7efa-187d-4e17-8685-05c6a5e39600",
              "name": "Successful response. Returns a JSON object when `stream=false`, or a server-sent events stream of `TextCompletionChunk` objects (terminated by `data: [DONE]`) when `stream=true`.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "fim",
                    "completions"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"model\": \"mercury-edit-2\",\n  \"prompt\": \"def fibonacci(n: int) -> int:\\n    if n <= 1:\\n        return n\\n    return \",\n  \"suffix\": \"\\n\\nprint(fibonacci(10))\\n\",\n  \"max_tokens\": 256\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"id\": \"cmpl-7a2b3c4d5e\",\n  \"object\": \"text_completion\",\n  \"created\": 1745798400,\n  \"model\": \"mercury-edit-2\",\n  \"choices\": [\n    {\n      \"index\": 0,\n      \"finish_reason\": \"stop\",\n      \"text\": \"fibonacci(n - 1) + fibonacci(n - 2)\"\n    }\n  ],\n  \"usage\": {\n    \"prompt_tokens\": 24,\n    \"completion_tokens\": 14,\n    \"total_tokens\": 38,\n    \"reasoning_tokens\": 0,\n    \"cached_input_tokens\": 0\n  }\n}",
